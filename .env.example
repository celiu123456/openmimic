# OpenMimic —— 任意 OpenAI 兼容接口(不配也能跑:内置演示房间全流程可玩,仅"让人格开口对话"需要)
LLM_BASE_URL=https://api.your-provider.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=your-model

# 思维链控制(thinking/reasoning models)
# off  = 从不发送 thinking 字段(适合不认识该字段的提供商)
# on   = 始终发送(适合任何支持 thinking 字段的提供商)
# 留空 = 仅当 LLM_BASE_URL 包含 deepseek 时自动发送(默认)
# LLM_THINKING_PARAM=

# 服务端口(默认 7860)
PORT=7860
