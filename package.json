{
  "name": "openmimic",
  "private": true,
  "version": "0.0.2",
  "description": "A general-purpose persona engine. Rebuild anyone. Rehearse anything.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "kernel",
    "engines/*",
    "server",
    "web",
    "plugins/*",
    "packages/*",
    "shared",
    "eval"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:server": "tsx server/src/main.ts",
    "dev:web": "npm run dev -w @openmimic/web",
    "dev": "npm run dev:server & npm run dev:web",
    "build:web": "npm run build -w @openmimic/web",
    "config:dump": "tsx scripts/config-dump.ts",
    "eval:calibrate": "tsx eval/src/cli-calibrate.ts",
    "eval:lowo": "tsx eval/src/cli-lowo.ts",
    "eval:stability": "tsx eval/src/cli-stability.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
