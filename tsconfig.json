{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@openmimic/shared": ["./shared/src/index.ts"],
      "@openmimic/kernel": ["./kernel/src/index.ts"],
      "@openmimic/engine-court": ["./engines/court/src/index.ts"],
      "@openmimic/engine-room": ["./engines/room/src/index.ts"],
      "@openmimic/engine-witness": ["./engines/witness/src/index.ts"],
      "@openmimic/server": ["./server/src/index.ts"],
      "@openmimic/fixtures": ["./fixtures/limo.ts"],
      "@openmimic/collector-freetext": ["./plugins/collector-freetext/src/index.ts"],
      "@openmimic/scenario-review": ["./plugins/scenario-review/src/index.ts"],
      "@openmimic/example-bridge": ["./plugins/example-bridge/src/index.ts"],
      "@openmimic/core": ["./packages/core/src/index.ts"],
      "@openmimic/eval": ["./eval/src/index.ts"]
    }
  },
  "include": [
    "shared/src/**/*.ts",
    "kernel/src/**/*.ts",
    "kernel/test/**/*.ts",
    "kernel/types/**/*.d.ts",
    "engines/court/src/**/*.ts",
    "engines/court/test/**/*.ts",
    "engines/room/src/**/*.ts",
    "engines/room/test/**/*.ts",
    "engines/witness/src/**/*.ts",
    "engines/witness/test/**/*.ts",
    "fixtures/**/*.ts",
    "server/src/**/*.ts",
    "server/test/**/*.ts",
    "plugins/*/src/**/*.ts",
    "plugins/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts",
    "eval/src/**/*.ts",
    "eval/test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
